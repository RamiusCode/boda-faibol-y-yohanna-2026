---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;

// Vista previa al compartir el link (WhatsApp, etc.): solo la imagen, sin
// descripción. El título va en blanco a propósito (carácter invisible) para
// que no se escriba ningún texto junto a la imagen.
const SITIO = "https://boda-faibol-y-yohanna-2026.vercel.app";
const IMAGEN_PREVIA = `${SITIO}/imagenes/portada-whatsapp.jpg?v=1`;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/favicon.png?v=3" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITIO + "/"} />
    <meta property="og:title" content="⠀" />
    <meta property="og:image" content={IMAGEN_PREVIA} />
    <meta property="og:image:secure_url" content={IMAGEN_PREVIA} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={IMAGEN_PREVIA} />

    <!--
      Las letras de los nombres salen del propio sitio: traerlas de Google
      obliga a dos viajes antes de poder dibujarlos. El resto va en un solo
      pedido a Google.
    -->
    <link rel="preload" href="/fonts/GreatVibes-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Charm-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/Callingstone - Personal Use Only.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* "only light" en ese orden: escrito al revés el navegador lo ignora */
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: only light;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color-scheme: only light;
        /* Como imagen y no como color: el modo oscuro forzado no lo invierte */
        background-image: linear-gradient(#f1e4e1, #f1e4e1);
      }

      /* La invitación SIEMPRE se ve como celular: columna centrada */
      main {
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        min-height: 100vh;
        background-image: url("/imagenes/fondoprincipal.webp"),
          linear-gradient(#faf3f1, #faf3f1);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.08);
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
