---
// src/components/ConteoRegalos.astro
// Invitación al tradicional conteo de regalos, al día siguiente de la boda
// (domingo), en el mismo salón. Va después de todo lo del sábado, con su
// propia banda y un arco blanco con doble filete dorado.
//
// La fecha va en el formato clásico de las participaciones, sin repetir el
// mes ni el año (ya están en la fecha de la boda):
//   DOMINGO  |  6  |  16:00 HRS.
// para que se lea de un vistazo que es otro día, no el sábado.
//
// Al asomar: el arco sube, el filete se dibuja por la cúpula, el medallón
// gira a su lugar y los renglones entran uno tras otro.
import FloresEsquinas from "./FloresEsquinas.astro";

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "CONTEO DE REGALOS";
const invitacion = ["Asimismo tenemos el agrado", "de invitarle(s) al tradicional"];
const nombreEvento = "Conteo de Regalos";
const fecha = { dia: "DOMINGO", mes: "DICIEMBRE", numero: "6", hora: "16:00 HRS.", anio: "2026" };
const aviso = "Al día siguiente de la boda";
const fraseLugar = "en el mismo salón de eventos";
const lugar = ["Salón de Eventos", "Colonial"];
const direccion = ["Av. 6 de Agosto y 1.º de Noviembre,", "frente a la Fac. de Derecho"];
const mapa = "https://maps.app.goo.gl/MxZNqnqJMmanntwW8";
const textoBoton = "Ver ubicación";
// ──────────────────────────────────────────────────────────────
---

<section id="franja-conteo" class="franja relative w-full py-8 px-7 overflow-hidden">
    <div class="franja-fondo absolute inset-0 bg-nacar">
        <span class="franja-filete arriba"></span>
        <span class="franja-filete abajo"></span>
    </div>

    <h2
        style="color:#b06a76"
        class="franja-texto relative font-callingstone text-[#b06a76] text-center text-[clamp(0.75rem,3.8vw,1.02rem)] tracking-[0.12em]"
    >
        {titulo}
    </h2>

    <div class="franja-texto adorno-oro relative mt-3" aria-hidden="true">
        <span></span><i></i><span></span>
    </div>
</section>

<section class="w-full flex justify-center pt-16 pb-24 px-6">
    <!-- Envoltorio: las flores se apoyan en la base del arco, por delante -->
    <div class="relative isolate w-full max-w-[340px]">
        <div
            id="arco-conteo"
            class="arco-luz arco-oro relative overflow-hidden w-full bg-nacar rounded-t-full shadow-[0_18px_40px_rgba(170,120,115,0.18)] flex flex-col items-center text-center px-6 pt-16 pb-14"
        >
            <!-- Regalo en un medallón dorado -->
            <div class="conteo-medallon medallon w-[64px] h-[64px]" aria-hidden="true">
                <svg class="conteo-regalo" viewBox="0 0 48 48">
                    <rect x="9" y="21" width="30" height="18" rx="2"></rect>
                    <rect x="7" y="15" width="34" height="6" rx="1.5"></rect>
                    <path d="M24 15v24"></path>
                    <path d="M24 15c-2.5-5.5-10-6-10-1.5 0 2.8 5.5 1.5 10 1.5z"></path>
                    <path d="M24 15c2.5-5.5 10-6 10-1.5 0 2.8-5.5 1.5-10 1.5z"></path>
                </svg>
            </div>

            <p class="conteo-linea font-cormorant font-medium italic text-[#b06a76] text-[clamp(1.2rem,5.6vw,1.4rem)] leading-[1.45] mt-7">
                {invitacion.map((linea) => <span class="block">{linea}</span>)}
            </p>

            <p class="conteo-linea font-great-vibes text-[#b06a76] text-[clamp(2.2rem,10vw,2.7rem)] leading-[1.2] mt-2 whitespace-nowrap conteo-sombra">
                {nombreEvento}
            </p>

            <div class="conteo-linea adorno-oro mt-2" aria-hidden="true">
                <span></span><i></i><span></span>
            </div>

            <!-- Fecha en formato de participación -->
            <div class="conteo-linea conteo-fecha mt-7" aria-label={`${fecha.dia} ${fecha.numero} de ${fecha.mes} de ${fecha.anio}, ${fecha.hora}`}>
                <div class="conteo-fecha-fila" aria-hidden="true">
                    <span class="conteo-fecha-lado">{fecha.dia}</span>
                    <span class="conteo-fecha-numero">{fecha.numero}</span>
                    <span class="conteo-fecha-lado">{fecha.hora}</span>
                </div>
            </div>

            <p class="conteo-linea font-cormorant font-medium italic text-[#a98532] text-[clamp(1.15rem,5.2vw,1.3rem)] mt-5">
                {aviso}
            </p>

            <!-- Corazón dorado entre la fecha y el lugar -->
            <div class="conteo-linea conteo-separador" aria-hidden="true">
                <span></span>
                <svg viewBox="0 0 24 24">
                    <path d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z"></path>
                </svg>
                <span></span>
            </div>

            <p class="conteo-linea font-cormorant font-medium italic text-[#b06a76] text-[clamp(1.15rem,5.2vw,1.3rem)]">
                {fraseLugar}
            </p>
            <p class="conteo-linea font-cormorant font-semibold text-[#b06a76] text-[clamp(1.4rem,6.4vw,1.6rem)] leading-[1.3] mt-1">
                {lugar.map((linea) => <span class="block whitespace-nowrap">{linea}</span>)}
            </p>
            <p class="conteo-linea font-cormorant font-medium italic text-[#a98532] text-[clamp(1.12rem,5.2vw,1.28rem)] leading-[1.45] mt-2">
                {direccion.map((linea) => <span class="block">{linea}</span>)}
            </p>

            <div class="conteo-linea mt-6">
                <a href={mapa} target="_blank" rel="noopener noreferrer" class="boton-fino">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"></path>
                    </svg>
                    {textoBoton}
                </a>
            </div>

            <div class="conteo-linea adorno-oro mt-8" aria-hidden="true">
                <span></span><i></i><span></span>
            </div>
        </div>
        <FloresEsquinas lados={["izq", "der"]} ancho={115} alFrente />
    </div>
</section>

<style>
    .conteo-sombra {
        text-shadow: 0 1px 8px rgba(199, 164, 103, 0.18);
    }

    /* Regalo dibujado en dorado dentro del medallón */
    .conteo-regalo {
        width: 32px;
        height: 32px;
        fill: none;
        stroke: #c9a45f;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    /* El medallón del arco blanco: el aro exterior va sobre blanco */
    .conteo-medallon {
        box-shadow:
            0 0 0 4px #fffaf8,
            0 0 0 5px rgba(199, 164, 103, 0.45),
            0 8px 18px rgba(170, 120, 115, 0.2);
    }

    /* ── Fecha en formato de participación ── */
    .conteo-fecha {
        width: 100%;
    }
    .conteo-fecha-dia,
    .conteo-fecha-anio {
        font-family: "Cormorant Garamond", serif;
        font-weight: 600;
        color: #a98532;
        font-size: clamp(0.9rem, 4.1vw, 1.02rem);
        letter-spacing: 0.32em;
        text-indent: 0.32em;
    }
    .conteo-fecha-fila {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 0.55rem;
        margin: 0.35rem 0;
    }
    /* Mes y hora entre dos filetes dorados */
    .conteo-fecha-lado {
        display: block;
        padding: 0.5rem 0;
        border-top: 1px solid rgba(201, 164, 95, 0.85);
        border-bottom: 1px solid rgba(201, 164, 95, 0.85);
        font-family: "Callingstone", cursive;
        font-weight: normal;
        color: #b06a76;
        font-size: clamp(0.76rem, 3.5vw, 0.92rem);
        letter-spacing: 0.06em;
        white-space: nowrap;
    }
    .conteo-fecha-numero {
        font-family: "Cormorant Garamond", serif;
        font-weight: 500;
        color: #b06a76;
        font-size: clamp(4rem, 19vw, 4.8rem);
        line-height: 0.9;
        padding: 0 0.15rem;
    }

    /* Corazón dorado entre filetes */
    .conteo-separador {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin: 1.4rem auto 1.1rem;
    }
    .conteo-separador span {
        width: 44px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #a67f3e);
    }
    .conteo-separador span:last-child {
        transform: scaleX(-1);
    }
    .conteo-separador svg {
        width: 13px;
        height: 13px;
        fill: #c9a45f;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { animarFranja } from "../scripts/animaciones";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const franja = document.getElementById("franja-conteo");
        if (franja) animarFranja(franja);

        const arco = document.getElementById("arco-conteo");
        if (!arco) return;

        const medallon = arco.querySelector(".conteo-medallon");
        const lineas = arco.querySelectorAll(".conteo-linea");

        // Se repite al volver a bajar y se esconde al salir por arriba
        const scrollTrigger = {
            trigger: arco,
            start: "top 88%",
            toggleActions: "restart none none reset",
        };

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            gsap.fromTo(arco, { opacity: 0 }, { opacity: 1, duration: 0.5, scrollTrigger });
            return;
        }

        gsap.timeline({ scrollTrigger })
            .fromTo(
                arco,
                { opacity: 0, y: 28, scale: 0.97 },
                { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: "sine.out" },
                0,
            )
            // El filete se dibuja de abajo hacia la cúpula
            .fromTo(
                arco,
                { "--filete": "100%" },
                { "--filete": "0%", duration: 1.5, ease: "power2.inOut" },
                0.2,
            )
            .fromTo(
                medallon,
                { opacity: 0, scale: 0.4, rotation: -25 },
                { opacity: 1, scale: 1, rotation: 0, duration: 0.9, ease: "back.out(1.8)" },
                0.35,
            )
            .fromTo(
                lineas,
                { opacity: 0, y: 12, filter: "blur(4px)" },
                {
                    opacity: 1,
                    y: 0,
                    filter: "blur(0px)",
                    duration: 0.7,
                    stagger: 0.08,
                    ease: "sine.out",
                    clearProps: "filter",
                },
                0.45,
            );
    });
</script>
