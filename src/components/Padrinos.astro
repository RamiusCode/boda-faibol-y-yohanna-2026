---
// src/components/Padrinos.astro
// Arco con los padrinos (religión y civil, torta y aro), con el mismo
// estilo que el arco de los padres de los novios.
//
// Al asomar: el arco sube, el filete crema se dibuja subiendo por el borde
// de la cúpula, los anillos giran a su lugar, los renglones aparecen uno
// tras otro y al final un destello de luz cruza el arco una sola vez.
// ── DATOS EDITABLES ───────────────────────────────────────────
import FloresEsquinas from "./FloresEsquinas.astro";
const bendicion = ["Nuestros padrinos"];

const padres = [
    {
        titulo: "PADRINOS DE RELIGIÓN Y CIVIL",
        nombres: ["René Crispin Argandoña", "Charo Hinojosa Villarroel"],
    },
    {
        titulo: "PADRINOS DE TORTA",
        nombres: ["Lic. Beatriz Crispin Argandoña", "Lic. Lucía Crispin Argandoña"],
    },
    {
        titulo: "PADRINOS DE ARO",
        nombres: ["Dr. Marcos Crispin Argandoña", "Dra. María Esther Vasquez Peralta"],
    },
];
// ──────────────────────────────────────────────────────────────
---

<!-- Mismo aire arriba y abajo: antes el pie era más grande (pb-24) que la cabeza. -->
<section id="padrinos" class="w-full flex justify-center pt-4 pb-20 px-6">
    <!-- Envoltorio: las flores se apoyan en la base del arco, por delante -->
    <div class="relative isolate w-full max-w-[340px]">
    <div
        id="arco-padrinos"
        class="arco-luz arco-oro relative overflow-hidden w-full max-w-[340px] bg-nacar rounded-t-full shadow-[0_18px_40px_rgba(170,120,115,0.18)] flex flex-col items-center text-center px-7 pt-16 pb-12"
    >
        <!-- Destello que cruza el arco al entrar -->
        <div class="padrinos-destello" aria-hidden="true"></div>

        <div class="padrinos-anillos medallon w-[62px] h-[62px]" aria-hidden="true">
            <span
                class="icono icono-tinta w-8 h-8"
                style="--ic:url('/imagenes/anillos-icono.png'); background-color:#a98532"></span>
        </div>

        <p class="font-great-vibes text-[#b8923a] text-[clamp(1.55rem,7.6vw,2.1rem)] leading-[1.5] mt-6 padrinos-sombra">
            {bendicion.map((linea) => (
                <span class="padrinos-linea block whitespace-nowrap">{linea}</span>
            ))}
        </p>

        <div class="padrinos-linea adorno-oro mt-4" aria-hidden="true">
            <span></span><i></i><span></span>
        </div>

        {
            padres.map((grupo, i) => (
                <div class={i === 0 ? "mt-7" : "mt-0"}>
                    {/* Entre las dos familias: un corazón dorado entre filetes */}
                    {i > 0 && (
                        <div class="padrinos-linea padrinos-separador" aria-hidden="true">
                            <span></span>
                            <svg viewBox="0 0 24 24">
                                <path d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0 1 12 6.5 5.3 5.3 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z" />
                            </svg>
                            <span></span>
                        </div>
                    )}
                    <h3 class="padrinos-linea font-callingstone text-[#a98532] text-[clamp(0.6rem,3.05vw,0.83rem)] tracking-[0.14em] leading-[1.7] px-2">
                        {grupo.titulo}
                    </h3>
                    {/* Padre y madre unidos por un "&" dorado, como en las
                        participaciones impresas */}
                    <div class="mt-3">
                        {grupo.nombres.map((nombre, j) => (
                            <>
                                {j > 0 && (
                                    <p
                                        class="padrinos-linea font-great-vibes text-[#a98532] text-[1.45rem] leading-[1.15]"
                                        aria-hidden="true"
                                    >
                                        &amp;
                                    </p>
                                )}
                                <p class="padrinos-linea font-balham text-marron text-[clamp(0.8rem,4vw,1.05rem)] tracking-wide whitespace-nowrap">
                                    {nombre}
                                </p>
                            </>
                        ))}
                    </div>
                </div>
            ))
        }

        <div class="padrinos-linea adorno-oro mt-8" aria-hidden="true">
            <span></span><i></i><span></span>
        </div>
    </div>
    <FloresEsquinas lados={["izq", "der"]} ancho={120} alFrente />
    </div>
</section>

<style>
    .padrinos-sombra {
        text-shadow: 0 1px 10px rgba(199, 164, 103, 0.18);
    }

    /* Corazón dorado entre los padres de la novia y los del novio */
    .padrinos-separador {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin: 1.7rem auto 1.5rem;
    }
    .padrinos-separador span {
        width: 44px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #a67f3e);
    }
    .padrinos-separador span:last-child {
        transform: scaleX(-1);
    }
    .padrinos-separador svg {
        width: 13px;
        height: 13px;
        fill: #a67f3e;
    }

    .padrinos-destello {
        position: absolute;
        top: -10%;
        bottom: -10%;
        left: -45%;
        width: 38%;
        pointer-events: none;
        background: linear-gradient(
            100deg,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 238, 220, 0.16) 50%,
            rgba(255, 255, 255, 0) 100%
        );
        transform: skewX(-14deg);
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const arco = document.getElementById("arco-padrinos");
        if (!arco) return;

        const anillos = arco.querySelector(".padrinos-anillos");
        const lineas = arco.querySelectorAll(".padrinos-linea");
        const destello = arco.querySelector(".padrinos-destello");

        // Mismo criterio que scripts/animaciones.ts: se repite al volver a
        // bajar y se esconde al salir por arriba.
        const scrollTrigger = {
            trigger: arco,
            start: "top 88%",
            toggleActions: "restart none none reset",
        };

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            gsap.fromTo(
                arco,
                { opacity: 0 },
                { opacity: 1, duration: 0.5, ease: "power1.out", scrollTrigger },
            );
            return;
        }

        gsap.timeline({ scrollTrigger })
            .fromTo(
                arco,
                { opacity: 0, y: 28, scale: 0.97 },
                { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: "sine.out" },
                0,
            )
            // El filete se dibuja de abajo hacia la cúpula
            .fromTo(
                arco,
                { "--filete": "100%" },
                { "--filete": "0%", duration: 1.5, ease: "power2.inOut" },
                0.2,
            )
            .fromTo(
                anillos,
                { opacity: 0, scale: 0.4, rotation: -25 },
                { opacity: 1, scale: 1, rotation: 0, duration: 0.9, ease: "back.out(1.8)" },
                0.35,
            )
            .fromTo(
                lineas,
                { opacity: 0, y: 12, filter: "blur(4px)" },
                {
                    opacity: 1,
                    y: 0,
                    filter: "blur(0px)",
                    duration: 0.7,
                    stagger: 0.08,
                    ease: "sine.out",
                },
                0.45,
            )
            // Un destello de luz cruza el arco una sola vez
            .fromTo(
                destello,
                // Recorre de sobra: por la inclinación, el pie de la franja
                // va atrasado y con menos se quedaba asomando abajo
                { xPercent: 0 },
                { xPercent: 560, duration: 1.6, ease: "power2.inOut" },
                1.1,
            );
    });
</script>
